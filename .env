# ==========================
# Port Configuration
# ==========================
NGINX_PORT=80
PHPMYADMIN_PORT=8081
MYSQL_PORT=3306

# ==========================
# MySQL Configuration
# ==========================
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DATABASE=app_db
MYSQL_USER=app_user
MYSQL_PASSWORD=app_pass

# Backup settings
USE_CONTAINER_DUMP=false
MYSQL_CONTAINER=om-mysql
BACKUP_DIR=./backups


# Backup Settings
BACKUP_DIR=./backups
RETENTION_DAYS=7

# ==========================
# AWS S3 Configuration
# ==========================
AWS_REGION=ap-southeast-2
S3_URI=s3://devops-mysql-backup-unique-name/mysql-backups/

# ==========================
# Application Settings
# ==========================
APP_ENV=production
APP_DEBUG=false
