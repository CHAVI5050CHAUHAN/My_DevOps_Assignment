# ---------------------------------------------------
# Port overrides for om-stack
# These override the ${VAR:-default} fallbacks in docker-compose.yml
# Make sure none of these conflict with ports already used on the host
# (you reported 80, 8080, 8081, 3306 are already taken)
# ---------------------------------------------------

# nginx (web app entrypoint)
NGINX_PORT=8082

# phpMyAdmin (DB admin UI)
PHPMYADMIN_PORT=8083

# MySQL (only needed if you connect to MySQL from OUTSIDE docker,
# e.g. with a local MySQL client on your machine)
MYSQL_PORT=3307
